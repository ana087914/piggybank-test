            "transactions"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "POST - Geld overmaken zonder bedrag",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Aanvraag zonder bedrag wordt geweigerd', () => pm.expect([400, 500]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
