        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderAccountId\": 2,\n  \"receiverAccountId\": 3,\n  \"description\": \"Betaling in dollar\",\n  \"amount\": 1,\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
